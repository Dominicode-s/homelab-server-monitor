APP_NAME="Homelab Sentinel"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
APP_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# For MySQL:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=homelab_sentinel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_COOKIE=homelab_sentinel_session

CACHE_STORE=database
CACHE_PREFIX=

QUEUE_CONNECTION=sync
CACHE_DRIVER=file
FILESYSTEM_DISK=local

# Admin account (set before first login)
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=changeme

# Email notifications for alerts (requires SMTP configuration above)
SENTINEL_ADMIN_EMAIL=admin@localhost
SENTINEL_NOTIFICATIONS_ENABLED=false
